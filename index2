      const res_g7 = ["68", "86", "24", "79"];

      const allPrizes = [res_db, res_g1, ...res_g2, ...res_g3, ...res_g4, ...res_g5, ...res_g6, ...res_g7];
      const todayLoto27 = allPrizes.map(p => p.slice(-2));

      // Xây dựng ma trận 100 số ưu tiên số tần suất cao
      const matrix100 = [];
      for (let i = 0; i < 100; i++) {
        const numStr = String(i).padStart(2, '0');
        const hotItem = HOT_NUMBERS_STATS[numStr];

        let totalHits, activeDraws, multiHits, gan, cycle, p1, p2, score, statusTag, statusColor;

