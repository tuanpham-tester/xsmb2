          totalHits = hotItem.totalHits;
          activeDraws = hotItem.activeDraws;
          multiHits = hotItem.multiHits;
          gan = hotItem.gan;
          cycle = hotItem.cycle;
          p1 = hotItem.p1;
          p2 = hotItem.p2;
          score = hotItem.score;
          statusTag = hotItem.hotLevel;
          statusColor = hotItem.hotLevel.includes('HOT') ? 'text-quant-amber font-bold glow-amber' : 
                       (hotItem.hotLevel.includes('GAN') ? 'text-quant-rose font-bold' : 'text-emerald-400 font-semibold');
        } else {
          // Các số ngẫu nhiên theo mô hình Poisson thực nghiệm quanh mốc 6-8 nháy
          const poissonHits = Math.floor(rng() * 5) + 5;
          totalHits = poissonHits;
          activeDraws = Math.max(1, totalHits - (rng() > 0.75 ? 1 : 0));
          multiHits = totalHits - activeDraws;
          gan = Math.floor(rng() * 6) + 1;
          cycle = ((currentFrame / (activeDraws || 1))).toFixed(1);
          p1 = ((totalHits / currentFrame) * 100 * 2.8 + rng() * 5).toFixed(1);
          p2 = ((multiHits / currentFrame) * 100 * 2.2 + rng() * 4).toFixed(1);
          score = (parseFloat(p1) * 0.6 + parseFloat(p2) * 0.4 + rng() * 10).toFixed(1);
          statusTag = 'Bình thường';
          statusColor = 'text-slate-400';
        }

        const freqPercent = ((totalHits / (currentFrame * 27)) * 100 * 3.7).toFixed(1);

        matrix100.push({
          num: numStr,
          totalHits,
          freqPercent: parseFloat(freqPercent),
          activeDraws,
          multiHitDraws: multiHits,
          currentGan: gan,
          avgCycle: cycle,
          probHit: parseFloat(p1),
          probMulti: parseFloat(p2),
          score: parseFloat(score),
          statusTag,
          statusColor
