        twoHits: { num: "68", prob: 42.6, subs: ["86", "24"] },
        pascal: { input: pascalInput, rows: pascalRows, apex: pascalApex }
      };

      try {
        localStorage.setItem(storageKey, JSON.stringify(finalData));
      } catch (err) {
        console.warn("LocalStorage full", err);
      }

      return finalData;
    }

